# Copy this file to .env and fill in real values before running

# SQLite by default (works out of the box). Swap for Postgres in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/bioscope
DATABASE_URL=sqlite:///./bioscope.db

# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme_dev_secret_key_replace_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
